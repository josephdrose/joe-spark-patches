+    # The entry is consumed, not reusable: a second lookup reads for itself.
+    again = torch.empty(shape, dtype=torch.bfloat16, device="cuda")
+    layer.lookup(ids, again)
+    assert len(gathers) == 1
+    assert torch.equal(again, plain)
