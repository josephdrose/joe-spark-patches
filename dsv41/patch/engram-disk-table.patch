+def test_engram_disk_prefetch_matches_lookup(num_tokens, tmp_path):
+    """Starting the read early must not change one bit of the result, and the
+    rows must actually come from it: the counter proves the lookup did not
+    quietly read them again."""
+    layer = _attach_disk_table(_make_embedding(False), tmp_path)
+    cols = 24
+    ids = torch.randint(
+        0, layer.part_num_embeddings, (num_tokens, cols), dtype=torch.int32,
+        device="cuda",
+    )
+    shape = (num_tokens, cols, layer.dim)
+    plain = torch.empty(shape, dtype=torch.bfloat16, device="cuda")
+    layer.lookup(ids, plain)
+
+    gathers = _count_gathers(layer)
+    layer.prefetch(ids)
+    prefetched = torch.empty(shape, dtype=torch.bfloat16, device="cuda")
+    layer.lookup(ids, prefetched)
+    assert not gathers, "the prefetched rows were read a second time"
+    assert torch.equal(prefetched, plain)
