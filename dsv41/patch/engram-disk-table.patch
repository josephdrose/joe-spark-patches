+def _attach_disk_table(layer, table_dir):
+    """Switch an embedding to a disk copy of the rows it already holds.
+
+    Row count comes from the weight, not `part_num_embeddings`: `_make_embedding`
+    sets the latter to the whole table so it can draw ids outside the window.
+    """
+    path = os.path.join(str(table_dir), "engram.bin")
+    build_row_file(path, layer.weight, layer.weight_scale_inv, layer.block_size)
+    layer.table_path = str(table_dir)
+    layer._table = DiskEngramTable(
+        path,
+        layer.dim,
+        row_start=layer.vocab_start_idx,
+        row_count=layer.weight.shape[0],
+        block_size=layer.block_size,
+    )
+    return layer
+
+
+def _count_gathers(layer):
+    """Count the synchronous reads a lookup does, returning the live list.
+
+    Every prefetch assertion below compares values, and the fallback read
+    returns the same values, so a `prefetch` that quietly did nothing would
+    pass all of them. This is what separates the two paths.
+    """
+    calls = []
+    original = layer._table.gather
+
+    def counted(indices):
+        calls.append(indices)
+        return original(indices)
+
+    layer._table.gather = counted
+    return calls
+
