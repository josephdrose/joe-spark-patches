+def _engram_disk_shard_weight_loader(
+    param: torch.nn.Parameter, loaded_weight: torch.Tensor
+) -> None:
+    """Stage this rank's head buckets for the on-disk row file.
+
+    Same narrowing as the resident loader, but the parameter holds no rows, so
+    the shard goes to the owning module instead. `narrow` is a view of the
