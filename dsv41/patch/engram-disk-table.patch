+def test_engram_disk_rows_replay_from_the_staging_buffer(tmp_path):
+    """The read cannot be captured, but the consumer of its rows can.
+
+    This is the shape a disk-backed serve has to use: stage the rows outside
+    the captured region, then capture only the arithmetic that reads them.
+    The graph must observe rows written into the buffer AFTER capture, or a
+    replay would serve whatever was live when it was recorded.
+    """
+    layer = _attach_disk_table(_make_embedding(False), tmp_path)
+    cols, rows, tokens = 24, layer.weight.shape[0], 4
+    ids = torch.randint(0, rows, (tokens, cols), dtype=torch.int32, device="cuda")
+    other = torch.randint(0, rows, (tokens, cols), dtype=torch.int32, device="cuda")
+    staged = torch.empty(tokens, cols, layer.dim, dtype=torch.bfloat16, device="cuda")
+
+    def consume():
+        # Stand-in for the wkv projection: any arithmetic over the staged rows.
+        return (staged.float() * 2.0 + 1.0).to(torch.bfloat16)
+
+    layer.lookup(ids, staged)
+    eager = consume().clone()
+
+    stream = torch.cuda.Stream()
+    stream.wait_stream(torch.cuda.current_stream())
+    with torch.cuda.stream(stream):
+        for _ in range(3):
+            consume()
+    torch.cuda.current_stream().wait_stream(stream)
+
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        captured = consume()
+    graph.replay()
+    torch.cuda.synchronize()
+    assert torch.equal(captured, eager)
+
+    # Different ids, staged in place after capture: the replay must follow the
+    # buffer contents, not a snapshot taken when the graph was recorded.
+    layer.lookup(other, staged)
+    expected = consume().clone()
+    layer.lookup(other, staged)
+    graph.replay()
+    torch.cuda.synchronize()
+    assert torch.equal(captured, expected)
+    assert not torch.equal(expected, eager), "the two id sets gave the same rows"
+
