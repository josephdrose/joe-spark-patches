+def test_engram_disk_lookup_matches_resident(num_tokens, tmp_path):
+    """The on-disk table must return the same bits as the resident one: same
+    rows, same ue8m0 decode (its byte is the fp32 exponent field, so byte 0 is
+    0.0 and not 2**-127), and the same zeros for rows another TP rank owns."""
+    layer = _make_embedding(False)
+    # Byte 0 is where a float8_e8m0fnu cast (2**-127) and the exponent-field
+    # decode (0.0) disagree, and the fixture's 120..133 band never covers it.
+    layer.weight_scale_inv[::7] = 0
+    cols, rows = 24, layer.part_num_embeddings
+    ids = torch.randint(0, rows, (num_tokens, cols), dtype=torch.int32, device="cuda")
+    shape = (num_tokens, cols, layer.dim)
+    resident = torch.empty(shape, dtype=torch.bfloat16, device="cuda")
+    layer.lookup(ids, resident)
+    disk = torch.empty(shape, dtype=torch.bfloat16, device="cuda")
+    _attach_disk_table(layer, tmp_path).lookup(ids, disk)
+    assert torch.equal(disk, resident)
+    assert torch.count_nonzero(resident), "both paths returned zeros"
